# ════════════════════════════════════════════════════════════════
# Club Náutico — Variables de Entorno (proyecto completo)
# ════════════════════════════════════════════════════════════════
# Este archivo documenta TODAS las variables que docker-compose.yml
# permite sobreescribir. Si no existe un ".env" real en la raíz del
# proyecto, Docker Compose usa los valores por defecto que se ven
# aquí (son de desarrollo local, no las credenciales reales de la
# nube/Railway — esas nunca se suben al repositorio).
#
# Para usarlo: copia este archivo a ".env" en la raíz y ajusta lo
# que necesites. No es obligatorio: docker-compose funciona igual
# sin él, usando estos mismos valores por defecto.

# ── AUTH-SERVICE · Base de datos (PostgreSQL) ──────────────────
AUTH_DB_NAME=club_nautica_auth_db
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=root
AUTH_SERVER_PORT=8081

# ── MS-SOCIOS · Base de datos (PostgreSQL) ─────────────────────
SOCIOS_DB_NAME=sociosDb
SOCIOS_DB_USER=postgres
SOCIOS_DB_PASSWORD=postgres

# ── MS-NAUTICA · Base de datos (MySQL) ─────────────────────────
NAUTICA_DB_NAME=club_nautica_db
NAUTICA_DB_PASSWORD=root
NAUTICA_DB_PORT=3307
NAUTICA_PORT=8083

# ── MS-FACTURACION · Base de datos (SQL Server) ────────────────
FACTURACION_DB_NAME=facturacionDb
FACTURACION_DB_PASSWORD=ClubNautico2026!
FACTURACION_PORT=8084

# ── MS-RESERVAS ─────────────────────────────────────────────────
RESERVAS_PORT=8085

# ── MS-NOTIFICACIONES ────────────────────────────────────────────
NOTIFICACIONES_PORT=8086

# ── API GATEWAY ──────────────────────────────────────────────────
GATEWAY_PORT=8080

# ── RABBITMQ ──────────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_QUEUE=nautica_events

# ── JWT (compartido entre auth-service, api-gateway y microservicios) ──
# Debe ser EXACTAMENTE el mismo valor en todos los servicios: si no
# coincide, los tokens se rechazan con 401/403.
JWT_SECRET=EstaEsUnaClaveMuySecretaDeAlMenos32Caracteres!!!
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_DAYS=7


# ════════════════════════════════════════════════════════════════
# DESPLIEGUE EN LA NUBE (Railway) — solo de referencia
# ════════════════════════════════════════════════════════════════
# Todo lo de abajo está COMENTADO a propósito: son las variables que
# usa cada servicio en producción (Railway), con los valores
# sensibles ocultos (***). Las credenciales reales solo existen en
# el dashboard de Railway (pestaña Variables de cada servicio),
# nunca en este repositorio. Esto es documentación, no se debe
# descomentar ni usar tal cual.

# ── api-gateway (único servicio con dominio público) ────────────
# GATEWAY_PORT=8080
# NODE_ENV=production
# JWT_SECRET=***
# CORS_ALLOWED_ORIGINS=https://club-nautico-poseidon-two.vercel.app,...
# AUTH_SERVICE_URL=http://auth-service.railway.internal:8080
# SOCIOS_SERVICE_URL=http://ms-socios.railway.internal:8080
# NAUTICA_SERVICE_URL=http://ms-nautica.railway.internal:8080
# FACTURACION_SERVICE_URL=http://ms-facturacion.railway.internal:8080
# RESERVAS_SERVICE_URL=http://ms-reservas.railway.internal:8080

# ── auth-service ──────────────────────────────────────────────
# SERVER_PORT=8080
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres.railway.internal:5432/railway
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=***
# SPRING_JPA_HIBERNATE_DDL_AUTO=update
# APP_JWT_SECRET=***
# CORS_ALLOWED_ORIGINS=https://club-nautico-poseidon-two.vercel.app,...
# EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server.railway.internal:8080/eureka/
# SPRING_CONFIG_IMPORT=optional:configserver:http://config-server.railway.internal:8080

# ── ms-socios ─────────────────────────────────────────────────
# SERVER_PORT=8080
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-4vib.railway.internal:5432/railway
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=***
# SPRING_JPA_HIBERNATE_DDL_AUTO=update
# APP_JWT_SECRET=***
# FACTURACION_SERVICE_URL=http://ms-facturacion.railway.internal:8080
# EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server.railway.internal:8080/eureka/
# SPRING_CONFIG_IMPORT=optional:configserver:http://config-server.railway.internal:8080

# ── ms-facturacion ────────────────────────────────────────────
# SERVER_PORT=8080
# SPRING_DATASOURCE_URL=jdbc:sqlserver://sqlserver2022docker.railway.internal:1433;databaseName=facturacionDb;encrypt=true;trustServerCertificate=true
# SPRING_DATASOURCE_USERNAME=sa
# SPRING_DATASOURCE_PASSWORD=***
# SPRING_JPA_HIBERNATE_DDL_AUTO=update
# APP_JWT_SECRET=***
# EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server.railway.internal:8080/eureka/
# SPRING_CONFIG_IMPORT=optional:configserver:http://config-server.railway.internal:8080

# ── ms-nautica ────────────────────────────────────────────────
# PORT=8080
# DB_HOST=mysql.railway.internal
# DB_PORT=3306
# DB_NAME=railway
# DB_USER=root
# DB_PASSWORD=***
# JWT_SECRET=***
# RABBITMQ_URL=amqp://***:***@rabbitmq.railway.internal:5672

# ── ms-reservas ───────────────────────────────────────────────
# PORT=8080
# NODE_ENV=production
# CORS_ORIGIN=https://club-nautico-poseidon-two.vercel.app,...
# MONGO_URI=mongodb+srv://***:***@clusterclubnautico.j7txt5r.mongodb.net/club_nautico_reservas

# ── notificaciones ────────────────────────────────────────────
# PORT=8080
# NODE_ENV=production
# RABBITMQ_URL=amqp://***:***@rabbitmq.railway.internal:5672
# RABBITMQ_QUEUE=nautica_events
# EUREKA_ENABLED=true
# EUREKA_HOST=eureka-server.railway.internal
# EUREKA_SSL=false

# ── eureka-server / config-server ────────────────────────────
# SERVER_PORT=8080
# (sin variables adicionales: no se conectan a ninguna BD ni servicio externo)

# NOTA: todas las URLs "*.railway.internal" son de la red privada interna
# de Railway, no accesibles desde fuera del proyecto. El único punto de
# entrada público del backend es api-gateway.
