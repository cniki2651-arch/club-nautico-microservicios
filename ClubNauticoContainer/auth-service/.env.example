# ── Servidor ──────────────────────────────────────────────────
SERVER_PORT=8081

# ── Base de datos (PostgreSQL) ───────────────────────────────
DB_URL=jdbc:postgresql://localhost:5433/club_nautica_auth_db
DB_USERNAME=postgres
DB_PASSWORD=CAMBIA_ESTO

# ── Seguridad JWT ─────────────────────────────────────────────
# Debe ser EXACTAMENTE la misma clave configurada en api-gateway y en los
# demas microservicios (si no coinciden, se rechazan los tokens).
JWT_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_DE_AL_MENOS_32_CARACTERES
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_DAYS=7

# ── CORS · Origenes permitidos (separados por coma) ────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Service discovery / config centralizada ────────────────────
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/
SPRING_CONFIG_IMPORT=optional:configserver:http://localhost:8888
