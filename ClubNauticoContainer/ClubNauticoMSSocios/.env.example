# ── Servidor ──────────────────────────────────────────────────
SERVER_PORT=8082

# ── Base de datos (PostgreSQL) ───────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/sociosDb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CAMBIA_ESTO

# Necesario para que Hibernate cree/actualice las tablas automaticamente.
# Sin esto, si el config-server no responde a tiempo al arrancar, el
# servicio se queda sin crear tablas nuevas.
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ── Seguridad JWT ─────────────────────────────────────────────
# Debe ser EXACTAMENTE la misma clave configurada en auth-service.
APP_JWT_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_DE_AL_MENOS_32_CARACTERES
APP_JWT_ACCESS_TOKEN_EXPIRATION_MS=3600000
APP_JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# ── Comunicacion con otros microservicios ──────────────────────
FACTURACION_SERVICE_URL=http://localhost:8084

# ── Service discovery / config centralizada ────────────────────
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/
SPRING_CONFIG_IMPORT=optional:configserver:http://localhost:8888
