# En docker-compose estas variables ya se inyectan desde el `environment:` del
# servicio en docker-compose.yml (con valores por defecto razonables). Este
# archivo documenta lo que el contenedor necesita si lo corres standalone
# (sin docker-compose) o en otro entorno (ej. Kubernetes).
PORT=8083
DB_HOST=db-nautica
DB_USER=root
DB_PASSWORD=CAMBIA_ESTO
DB_NAME=club_nautica_db

# Debe ser EXACTAMENTE el mismo valor que usa auth-service para firmar los JWT.
JWT_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_DE_AL_MENOS_32_CARACTERES

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
