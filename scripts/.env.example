# Credenciales de las bases de datos de Railway (produccion/nube).
# NO subir un .env real con estos valores rellenos al repo — es publico.
# Pide los valores reales a quien administra el proyecto en Railway.

RAILWAY_AUTH_PG_URL=postgresql://usuario:password@host.proxy.rlwy.net:puerto/railway
RAILWAY_SOCIOS_PG_URL=postgresql://usuario:password@host.proxy.rlwy.net:puerto/railway

RAILWAY_NAUTICA_MYSQL_HOST=host.proxy.rlwy.net
RAILWAY_NAUTICA_MYSQL_PORT=puerto
RAILWAY_NAUTICA_MYSQL_PASSWORD=password

RAILWAY_FACTURACION_MSSQL_HOST=host.proxy.rlwy.net
RAILWAY_FACTURACION_MSSQL_PORT=puerto
RAILWAY_FACTURACION_MSSQL_PASSWORD=password
