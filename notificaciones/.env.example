# Puerto del servidor Express (health check)
PORT=8086
NODE_ENV=production

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_QUEUE=nautica_events

# Eureka (registro de servicios)
EUREKA_HOST=eureka-server
EUREKA_PORT=8761
EUREKA_ENABLED=true
# Poner en "true" solo si Eureka esta detras de HTTPS (ej. en la nube)
EUREKA_SSL=false

# Identificacion del servicio dentro de Eureka
SERVICE_HOST=notificaciones
