# ──────────────────────────────────────────────
#  MS-NOTIFICACIONES — Variables de entorno
#  Copiar a .env y ajustar valores
# ──────────────────────────────────────────────

# Puerto del servidor Express (health check)
PORT=8086

# Entorno
NODE_ENV=production

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_QUEUE=nautica_events

# Eureka (registro de servicios)
EUREKA_HOST=eureka-server
EUREKA_PORT=8761
EUREKA_ENABLED=true

# Identificación del servicio
SERVICE_HOST=notificaciones
SERVICE_IP_ADDR=127.0.0.1
