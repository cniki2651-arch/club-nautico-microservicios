# ════════════════════════════════════════════════════════════════
#  Club Náutico — API Gateway · Variables de Entorno
#  Copia este archivo como ".env" y ajusta los valores locales
# ════════════════════════════════════════════════════════════════

# ── Servidor Gateway ──────────────────────────────────────────
GATEWAY_PORT=8080
NODE_ENV=development

# ── Seguridad JWT ─────────────────────────────────────────────
# Debe ser EXACTAMENTE la misma clave configurada en el auth-service
# (app.jwt.secret en application.yaml)
JWT_SECRET=EstaEsUnaClaveMuySecretaDeAlMenos32Caracteres!!!

# ── URLs de Microservicios (targets del proxy) ─────────────────
AUTH_SERVICE_URL=http://localhost:8081
# SOCIOS_SERVICE_URL=http://localhost:8082
# NAUTICA_SERVICE_URL=http://localhost:8083

# ── CORS · Orígenes permitidos (separados por coma) ───────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
